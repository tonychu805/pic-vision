# Copy to .env (gitignored) and fill in. Keep it chmod 600 -- these are live
# credentials that can spend money and read every venue's footage.
#
# None of this belongs on a venue's machine. The desktop agent holds no
# credentials at all since ADR-084; only the operator's own workstation
# (which runs cloud_pipeline/job_runner.py) needs this file.

# RunPod: creates and bills the GPU pods that run inference.
RUNPOD_API_KEY=

# Cloudflare R2: read/write access to all uploaded footage and finished reels.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Job runner (cloud_pipeline/job_runner.py): shared secret authenticating it
# to the cloud console. Must match RUNNER_TOKEN in the console's own env
# (Netlify). Generate with: openssl rand -base64 32
RUNNER_TOKEN=
CONSOLE_URL=https://console.picvisionai.com
