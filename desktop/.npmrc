# `npm version` tags as desktop-v1.2.0, matching what
# .github/workflows/desktop-mac.yml triggers on. Without this it tags
# v1.2.0, the workflow never fires, and the release silently doesn't
# happen -- the version is bumped and committed either way, so the next
# attempt starts from a number that looks already-released.
tag-version-prefix=desktop-v
