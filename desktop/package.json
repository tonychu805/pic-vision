{
  "name": "pic-vision-desktop",
  "version": "1.1.0",
  "description": "Venue owner desktop client: camera discovery/management for pic-vision (STRATEGY.md §5)",
  "author": "picvision ai",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron . --no-sandbox --remote-debugging-port=9223",
    "dev": "concurrently -k -n renderer,electron -c blue,green \"npm run dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "test": "node --import ./electron/register-stub.mjs --test \"electron/**/*.test.js\""
  },
  "build": {
    "appId": "com.picvisionai.desktop",
    "productName": "Pic Vision Camera Manager",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "afterPack": "build/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Pic Vision Camera Manager uses your local network to find and connect to your cameras."
      },
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "PicVision-CameraManager-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "electron-store": "^10.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onvif": "^0.8.2",
    "oui-data": "^2.1.12",
    "posthog-node": "^5.51.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
