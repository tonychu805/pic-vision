# Session captures / recordings & pipeline video outputs — never commit video
# (covers highlights.mp4, rallies_full.mp4, and raw session_*.mkv captures)
*.mp4
*.mkv
*.mov
*.avi
*.MP4
*.MKV
*.MOV
*.AVI

# Python
__pycache__/
*.pyc
.venv*/
venv/
.pytest_cache/

# macOS
.DS_Store

# Secrets — never commit API keys
.env

# Pipeline stage artifacts (regenerable)
cache/

# Model weights (auto-downloaded or too large for git)
*.pt
*.h5
*.mlpackage/

# Web UI runtime job data (uploaded video, calib, predictions, reel per job)
# -- regenerable, not source, like cache/ and clips/.
webapp/jobs/
cloud_pipeline/jobs/
webapp/webapp.log

# Pipeline inference outputs (regenerable from footage + pod_infer.py).
# NOTE: the old pattern was `predictions*.csv`, which only matched files whose
# NAME STARTS WITH "predictions" — so every real output (IMG_7743_predictions_k14.csv
# and friends) slipped through and cluttered the repo root. Match anywhere.
*predictions*.csv
*_rallies.json
clips/
debug_frames/

# Analysis images (scatter plots, annotated frames) — regenerable, often multi-MB
*.png
*.jpg
# ...except real, committed UI assets (not regenerable analysis output)
!desktop/src/assets/*.png

# Ad hoc reference material (chat exports, etc.) — not project docs, don't belong in history
*.pdf

# NOT ignored, on purpose — commit these:
#   eval/labels/*.jsonl   hand-labeled ground truth (the whole basis for §5 metrics)
#   eval/labels/*_gaps*.jsonl  intermediate pass-3 review files ARE ignored below
#   calib/*.json          per-camera court calibrations (small, and re-clicking is manual work)
#   .env.example          template for .env, which IS ignored
#   sessions.jsonl, tallies/*.md   small config / notes

# Pass-3 gap-review scratch files: detector proposals extracted for human
# judging. Regenerable from labels + predictions via scripts/review_gaps.py,
# and not ground truth themselves — unlike the real labels beside them.
eval/labels/*_gaps.jsonl
eval/labels/*_gaps_all.jsonl
._*
.DS_Store
